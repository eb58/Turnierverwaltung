RewriteEngine On

# Interne Weiterleitungen nach client/ und server/ nicht erneut umschreiben.
RewriteCond %{ENV:REDIRECT_STATUS} !^$
RewriteRule ^ - [L]

# Laufzeitdaten und Servercode sind nie direkt abrufbar.
RewriteRule ^(?:data|server|client)(?:/|$) - [F,L,NC]

# Die API liegt in server/, alle übrigen Dateien in client/.
RewriteRule ^api\.php$ server/api.php [L]
RewriteRule ^(.*)$ client/$1 [L]
